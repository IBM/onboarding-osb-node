{
  "name": "onboarding-osb-node",
  "version": "1.0.0",
  "private": true,
  "description": "Open Service Broker Reference App",
  "keywords": [],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/IBM/onboarding-osb-node.git"
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc",
    "start": "pnpm clean && tsc && node dist/src/app.js",
    "start:dev": "tsx watch src/app.ts",
    "dev": "tsx watch src/app.ts",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "lint-fix": "oxlint src --fix",
    "format": "oxfmt --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "node -e \"if(require('fs').existsSync('.git')) { require('child_process').execSync('husky install', {stdio:'inherit'}) }\"",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migrate:generate": "pnpm typeorm migration:generate -d ./src/db/data-source.ts",
    "migrate": "pnpm typeorm migration:run -d ./src/db/data-source.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-base64": "^3.9.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.31",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "9.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.19.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^8.2.2",
    "husky": "9.0.11",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
